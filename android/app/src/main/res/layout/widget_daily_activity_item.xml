<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Row 1: Time ActivityName Debit Credit Points -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Time: 00:00 - 00:00 -->
        <TextView
            android:id="@+id/item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 - 00:00"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Activity Name: White normally, Green if goal (NO code) -->
        <TextView
            android:id="@+id/item_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Activity"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Debit (Red UI, NO parentheses, GONE if 0) -->
        <TextView
            android:id="@+id/item_debit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="-50"
            android:textColor="#EF4444"
            android:textSize="10sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

        <!-- Credit (Green UI, NO parentheses, GONE if 0) -->
        <TextView
            android:id="@+id/item_credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:text="+200"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

        <!-- Points: Blue (#38BDF8) normally, Green (#10B981) if goal -->
        <TextView
            android:id="@+id/item_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="+2 pts"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Row 2: Description (Full, no truncation/ellipsis) -->
    <TextView
        android:id="@+id/item_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="6dp"
        android:layout_marginLeft="6dp"
        android:text="Description"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
