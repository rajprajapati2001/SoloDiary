<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#3B82F6"
                android:endColor="#4338CA"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_widget_plus"
        android:width="32dp"
        android:height="32dp"
        android:gravity="center" />
</layer-list>
