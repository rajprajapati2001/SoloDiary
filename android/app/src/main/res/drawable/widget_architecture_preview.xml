<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. Base 1x4 Timeline Bar Track -->
    <item
        android:width="220dp"
        android:height="40dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0F172A" />
            <stroke android:width="1.5dp" android:color="#334155" />
        </shape>
    </item>

    <!-- 2. Sleep Block (Blue) -->
    <item
        android:width="60dp"
        android:height="36dp"
        android:left="2dp"
        android:top="2dp"
        android:bottom="2dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="10dp"
                android:bottomLeftRadius="10dp"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="#1E40AF" />
        </shape>
    </item>

    <!-- 3. Breakfast Block (Pink) -->
    <item
        android:width="26dp"
        android:height="36dp"
        android:left="62dp"
        android:top="2dp"
        android:bottom="2dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#F472B6" />
        </shape>
    </item>

    <!-- 4. Work Block (Amber/Yellow) -->
    <item
        android:width="55dp"
        android:height="36dp"
        android:left="88dp"
        android:top="2dp"
        android:bottom="2dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#CB9801" />
        </shape>
    </item>

    <!-- 5. Reading Block (Emerald) -->
    <item
        android:width="35dp"
        android:height="36dp"
        android:left="143dp"
        android:top="2dp"
        android:bottom="2dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#10B981" />
        </shape>
    </item>

    <!-- 6. Exercise Block (Purple) -->
    <item
        android:width="40dp"
        android:height="36dp"
        android:left="178dp"
        android:top="2dp"
        android:bottom="2dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:topRightRadius="10dp"
                android:bottomRightRadius="10dp" />
            <solid android:color="#8B5CF6" />
        </shape>
    </item>

</layer-list>
