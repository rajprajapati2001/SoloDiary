<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. Base Card Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1E293B" />
            <stroke android:width="1.2dp" android:color="#334155" />
        </shape>
    </item>

    <!-- 2. Accent Box (Positioned using margins) -->
    <item
        android:width="36dp"
        android:height="36dp"
        android:top="16dp"
        android:left="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#263B82F6" />
        </shape>
    </item>

    <!-- 3. Icon Centered Inside the Accent Box using Gravity -->
    <!-- We match the same top/left bounds and use gravity="center" so it never drifts -->
    <item
        android:width="22dp"
        android:height="22dp"
        android:top="16dp"
        android:left="16dp"
        android:right="16dp"
        android:bottom="16dp"
        android:gravity="center"
        android:drawable="@drawable/ic_widget_calendar" />

</layer-list>