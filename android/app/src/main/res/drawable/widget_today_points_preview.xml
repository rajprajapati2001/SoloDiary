<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. Background Card -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="160dp" android:height="90dp" />
            <corners android:radius="16dp" />
            <solid android:color="#1E293B" />
            <stroke android:width="1.2dp" android:color="#334155" />
        </shape>
    </item>

    <!-- 2. Centered Accent Box -->
    <item
        android:width="44dp"
        android:height="44dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#2610B981" />
        </shape>
    </item>

    <!-- 3. Centered Target Icon -->
    <item
        android:drawable="@drawable/ic_widget_target"
        android:width="26dp"
        android:height="26dp"
        android:gravity="center" />

</layer-list>