<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#8B5CF6"
                android:centerColor="#7C3AED"
                android:endColor="#4338CA"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_widget_mic"
        android:width="28dp"
        android:height="28dp"
        android:gravity="center" />
</layer-list>
